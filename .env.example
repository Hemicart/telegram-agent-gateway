# Everything is optional: the setup page collects what it needs and stores it under /data.
# DATA_DIR=/data
# PORT=8080
# AGENT_FOLDER_TITLE=Agent
# SETUP_PASSWORD=            # optional: if set, pressing Start asks for it (the first browser otherwise owns the server)
# AGENT_API_TOKEN=           # if empty, created in the setup page (only a hash is stored)
# TELEGRAM_API_ID=           # normally entered in the setup page
# TELEGRAM_API_HASH=
# ALLOW_BROAD_FOLDER=0
# ALLOWLIST_STALE_MAX_SECONDS=300
# MAX_PAGE_SIZE=100
# MEDIA_MAX_BYTES=20971520
# MEDIA_CACHE_MAX_BYTES=524288000
# LOG_LEVEL=INFO
# ALLOW_PLAIN_HTTP=0         # never set to 1 on the internet
